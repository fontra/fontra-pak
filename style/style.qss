QFrame#dropArea {
    border-radius: 20px;
    border: 5px dashed lightgray;
    padding: 16px;
    background-color: rgba(255,255,255,128);
}

QFrame#dropArea QLabel {
    font-size: 18px;
}

QFrame#dropArea QLabel#dropAreaTitle {
    font-size: 40px;
}

QFrame#dropArea[dropping="true"] {
    background-color: rgba(255,255,255,64);
    border-color: gray;
}

DropAreaFrame {
    border-radius: 20px;
    border: 5px dashed lightgray;
    padding: 16px;
    background-color: rgba(255,255,255,128);
}

DropAreaFrame QLabel {
    font-size: 18px;
    margin-top: 18px;
    qproperty-alignment: AlignCenter;
}

DropAreaFrame QLabel#dropAreaTitle {
    font-size: 40px;
    margin-top: 0;
}

DropAreaFrame QLabel#dropAreaSubtitle {
    margin-top: -6px;
}

DropAreaFrame[dropping="true"] {
    background-color: rgba(255,255,255,64);
    border-color: gray;
}

QMessageBox QTextEdit {
    font-weight: regular;
}
